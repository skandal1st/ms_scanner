<?xml version="1.0" encoding="UTF-8"?>
<ServerApplication xmlns="https://apps-api.moysklad.ru/xml/ns/appstore/app/v2"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="https://apps-api.moysklad.ru/xml/ns/appstore/app/v2
                                       https://apps-api.moysklad.ru/xml/ns/appstore/app/v2/application-v2.xsd">
    <iframes>
        <iframe type="main" sourceUrl="https://skandata.ru/ms"/>
    </iframes>
    <!-- Кастомная кнопка на документе Отгрузка: открывает окно сборки Скандаты.
         Обработчик нажатия — POST /api/moysklad/vendor/1.0/apps/{appId}/{accountId}/button. -->
    <buttons>
        <button name="startShipment" title="Собрать в Скандата">
            <locations>
                <document.demand.edit/>
            </locations>
        </button>
    </buttons>
    <!-- Кастомное модальное окно (открывается из кнопки через action=showPopup). -->
    <popups>
        <popup>
            <name>scanPopup</name>
            <sourceUrl>https://skandata.ru/popup</sourceUrl>
        </popup>
    </popups>
    <vendorApi>
        <endpointBase>https://skandata.ru</endpointBase>
    </vendorApi>
    <access>
        <resource>https://api.moysklad.ru/api/remap/1.2</resource>
        <scope>custom</scope>
        <permissions>
            <!-- Просмотр отчёта «Остатки» (report/stock) — для сверки остатков в Инвентаризации.
                 Без него report/stock/all возвращает нули. -->
            <viewStockReport/>
            <supply>
                <view/>
                <update/>
            </supply>
            <demand>
                <view/>
                <update/>
            </demand>
            <good>
                <view/>
                <update/>
            </good>
            <employee>
                <view/>
            </employee>
            <!-- Склады (справочник): список складов + остаток по конкретному складу (мультиюрлицо). -->
            <warehouse>
                <view/>
            </warehouse>
        </permissions>
    </access>
</ServerApplication>
