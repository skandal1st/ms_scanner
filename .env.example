# Database
POSTGRES_DB=ms_scaner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# МойСклад OAuth (https://dev.moysklad.ru/)
MOYSKLAD_CLIENT_ID=
MOYSKLAD_CLIENT_SECRET=
MOYSKLAD_REDIRECT_URI=http://localhost:3000/auth/callback

# МойСклад Vendor API — заполняется после создания черновика решения в dev.moysklad.ru.
# MOYSKLAD_APP_UID — формат "alias_решения.alias_разработчика".
# MOYSKLAD_VENDOR_SECRET_KEY — секретный ключ из ЛК разработчика, используется для проверки JWT-подписи.
MOYSKLAD_APP_UID=
MOYSKLAD_VENDOR_SECRET_KEY=

# Честный Знак (для коробов SSCC после входа по УКЭП; одиночные КМ проверяются без API ЧЗ)
CZ_MOCK_MODE=false
CZ_AUTH_METHOD=cprob_plugin
# Для песочницы ЧЗ укажите: https://markirovka.sandbox.crptech.ru
CZ_API_BASE_URL=https://markirovka.crpt.ru
# Товарные группы для детекта агрегатов (блок) через True API cises/info — перебор pg.
CZ_PRODUCT_GROUPS=otp,tobacco,ncp

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (через запятую)
CORS_ORIGINS=http://localhost:3000

# Frontend (для docker-compose)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
